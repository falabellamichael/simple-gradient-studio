{
  "name": "simple-gradient-studio",
  "displayName": "SimpleGradient Studio",
  "description": "Design reusable app, page, and panel gradients, then apply them through the native SimpleRAG extension.",
  "version": "0.3.0",
  "publisher": "falabella",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/falabellamichael/simple-gradient-studio.git"
  },
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gradient",
    "theme",
    "color",
    "design tokens",
    "visual editor",
    "css"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:simpleGradient.openStudio",
    "onCommand:simpleGradient.openAssignments",
    "onCommand:simpleGradient.openPreview",
    "onCommand:simpleGradient.importProfile",
    "onCommand:simpleGradient.exportProfile",
    "onCommand:simpleGradient.installSimpleRag",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simpleGradient.openStudio",
        "title": "Open Gradient Studio",
        "category": "SimpleGradient",
        "icon": "$(symbol-color)"
      },
      {
        "command": "simpleGradient.openAssignments",
        "title": "Open Gradient Assignments",
        "category": "SimpleGradient",
        "icon": "$(layout)"
      },
      {
        "command": "simpleGradient.openPreview",
        "title": "Open Gradient Preview",
        "category": "SimpleGradient",
        "icon": "$(open-preview)"
      },
      {
        "command": "simpleGradient.importProfile",
        "title": "Import Gradient Profile...",
        "category": "SimpleGradient",
        "icon": "$(cloud-download)"
      },
      {
        "command": "simpleGradient.exportProfile",
        "title": "Export Gradient Profile...",
        "category": "SimpleGradient",
        "icon": "$(export)"
      },
      {
        "command": "simpleGradient.installSimpleRag",
        "title": "Install or Update SimpleRAG Extension",
        "category": "SimpleGradient",
        "icon": "$(plug)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simpleGradientStudio",
          "title": "SimpleGradient Studio",
          "icon": "media/simple-gradient.svg"
        }
      ]
    },
    "views": {
      "simpleGradientStudio": [
        {
          "type": "webview",
          "id": "simpleGradient.studioView",
          "name": "Studio",
          "icon": "media/simple-gradient.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "simpleGradient.openStudio"
        },
        {
          "command": "simpleGradient.openAssignments"
        },
        {
          "command": "simpleGradient.openPreview"
        },
        {
          "command": "simpleGradient.importProfile"
        },
        {
          "command": "simpleGradient.exportProfile"
        },
        {
          "command": "simpleGradient.installSimpleRag"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build-simplerag-studio-bundle && npm run build",
    "build": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "test": "npm run build && node --test test/*.test.cjs",
    "preview": "node scripts/preview-server.cjs",
    "package": "npm run build-simplerag-studio-bundle && vsce package --out simple-gradient-studio-0.3.0.vsix",
    "build-simplerag-studio-bundle": "node scripts/build-simplerag-studio-bundle.cjs"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.5.2"
  }
}